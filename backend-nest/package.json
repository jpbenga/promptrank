{
  "name": "@promptrank/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "jest src --runInBand",
    "test:integration": "jest test/phase1.integration.spec.ts test/phase2.prompts.integration.spec.ts test/phase3.prompt-runs.integration.spec.ts test/phase4.visibility-scores.integration.spec.ts test/phase5.action-cards.integration.spec.ts --runInBand",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "set -a; [ -f ../.env ] && . ../.env; [ -f .env ] && . .env; set +a; prisma generate",
    "prisma:migrate": "set -a; [ -f ../.env ] && . ../.env; [ -f .env ] && . .env; set +a; prisma migrate dev"
  },
  "dependencies": {
    "@promptrank/shared-types": "workspace:*",
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.2.3",
    "@nestjs/core": "10.4.15",
    "@nestjs/mapped-types": "2.0.5",
    "@nestjs/platform-express": "10.4.15",
    "@prisma/client": "5.20.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "csv-parse": "5.5.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.15",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/multer": "^2.1.0",
    "@types/supertest": "^7.2.0",
    "jest": "29.7.0",
    "prisma": "5.20.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.6.3"
  }
}
