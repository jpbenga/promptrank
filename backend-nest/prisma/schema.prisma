generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id              String             @id @default(cuid())
  name            String
  source          String             @default("csv")
  primaryLanguage String
  targetCountry   String
  currency        String
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  csvImports      CsvImport[]
  mappings        CsvColumnMapping[]
  products        Product[]
  prompts         ProductPrompt[]
  promptRuns      PromptRun[]
  visibilityScores VisibilityScore[]
}


model CsvImport {
  id                String             @id @default(cuid())
  projectId         String
  originalFileName  String
  detectedDelimiter String
  columns           Json
  previewRows       Json
  rows              Json
  rowCount          Int
  status            String             @default("uploaded")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  mappings          CsvColumnMapping[]
}

model CsvColumnMapping {
  id          String    @id @default(cuid())
  projectId   String
  csvImportId String
  mapping     Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  csvImport   CsvImport @relation(fields: [csvImportId], references: [id], onDelete: Cascade)
}

model Product {
  id              String   @id @default(cuid())
  projectId       String
  source          String
  externalId      String?
  sku             String?
  title           String
  description     String?
  brand           String?
  vendor          String?
  productType     String?
  category        String?
  price           Float?
  currency        String?
  availability    String?
  stockQuantity   Int?
  url             String?
  imageUrls       Json?
  tags            Json?
  seoTitle        String?
  metaDescription String?
  gtin            String?
  rating          Float?
  reviewsCount    Int?
  attributes      Json?
  rawSource       Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prompts         ProductPrompt[]
  promptRuns      PromptRun[]
  visibilityScores VisibilityScore[]
}


model ProductPrompt {
  id        String   @id @default(cuid())
  projectId String
  productId String
  text      String
  language  String
  country   String
  intent    String
  source    String   @default("template")
  status    String   @default("proposed")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  runs      PromptRun[]

  @@index([projectId, productId])
}

model PromptRun {
  id                   String   @id @default(cuid())
  projectId            String
  productId            String
  promptId             String
  provider             String   @default("mock")
  model                String   @default("mock-v1")
  responseText         String
  brandMentioned       Boolean
  productMentioned     Boolean
  competitorsMentioned Json
  position             Int?
  sentiment            String   @default("unknown")
  status               String   @default("completed")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  prompt               ProductPrompt @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@index([projectId, promptId])
  @@index([projectId, productId])
}

model VisibilityScore {
  id                   String   @id @default(cuid())
  projectId            String
  productId            String?
  scope                String
  score                Int
  analyzedPromptsCount Int
  brandMentionRate     Float
  productMentionRate   Float
  competitorMentionRate Float
  averagePosition      Float?
  dominantSentiment    String
  topCompetitors       Json
  details              Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  product              Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([projectId, scope])
  @@index([projectId, productId])
}
