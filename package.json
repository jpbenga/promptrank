{
  "name": "promptrank",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter @promptrank/api dev\" \"pnpm --filter @promptrank/web dev\"",
    "dev:api": "pnpm --filter @promptrank/api dev",
    "dev:web": "pnpm --filter @promptrank/web dev",
    "build": "pnpm -r build",
    "test": "pnpm test:api && pnpm test:web",
    "test:api": "pnpm db:test:prepare && pnpm --filter @promptrank/api test",
    "test:web": "pnpm --filter @promptrank/web test",
    "test:integration": "pnpm db:test:prepare && pnpm --filter @promptrank/api test:integration",
    "test:e2e": "playwright test",
    "lint": "pnpm -r lint",
    "verify": "pnpm lint && pnpm test && pnpm build",
    "verify:e2e": "pnpm verify && pnpm test:e2e",
    "db:generate": "pnpm --filter @promptrank/api prisma:generate",
    "db:migrate": "pnpm --filter @promptrank/api prisma:migrate",
    "db:test:prepare": "node scripts/prepare-test-db.js"
  },
  "devDependencies": {
    "@playwright/test": "1.48.2",
    "concurrently": "9.1.2"
  }
}
